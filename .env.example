# ─────────────────────────────────────────────────────────────────────────────
# Ajo Web — environment variable reference
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# All variables must be prefixed with VITE_ so Vite exposes them
# to the browser bundle via import.meta.env.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# In development this is typically proxied via Vite's server.proxy.
VITE_API_URL=http://localhost:8000/api

# Sentry DSN for error tracking.
# Leave blank (or omit) to disable Sentry — the app runs fine without it.
VITE_SENTRY_DSN=

# Google OAuth "Web application" client ID — same value as ajo-app's
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (it's the same Google Cloud OAuth client,
# just used from a different platform). Get it from Google Cloud Console →
# APIs & Services → Credentials. "Continue with Google" silently fails to
# render if this is left blank.
VITE_GOOGLE_CLIENT_ID=
