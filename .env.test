# ─────────────────────────────────────────────────────────────────────────────
# Test-mode overrides — committed (unlike .env), since it holds no secrets.
#
# Vite loads .env, then .env.test on top of it for anything running under
# vitest (mode defaults to "test"). Without this file, a developer's local
# .env — e.g. VITE_API_URL=http://localhost:8000/api — leaks into test runs.
# api.ts's axios baseURL then becomes an absolute URL instead of the relative
# '/api' MSW's mock handlers are registered against, so every request
# silently bypasses the mock and hits a real network call that fails.
# (Set explicitly to '/api' rather than left blank — Vite defines VITE_* keys
# as an empty string, not undefined, so api.ts's `?? '/api'` fallback never
# fires for an unset-but-present value.)
# CI never hit this (no .env file there); this makes local test runs behave
# the same way.
# ─────────────────────────────────────────────────────────────────────────────

VITE_API_URL=/api
